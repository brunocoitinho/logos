# Copie para infra/.env NA VPS e preencha. O .env nunca vai para o Git.
# Para gerar cada segredo: openssl rand -hex 32

API_DOMAIN=logos-api.startbc.online

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# 32+ caracteres; a API não sobe em produção sem ele.
JWT_SECRET=

# Origens do front autorizadas a chamar a API, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# Opcional: padrão para origens dinâmicas, como as prévias de PR da Vercel.
# Ex.: CORS_ORIGIN_REGEX=https://logos-[a-z0-9-]+-SEU-TIME\.vercel\.app
CORS_ORIGIN_REGEX=
